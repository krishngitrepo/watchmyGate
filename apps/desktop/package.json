{
  "name": "@watchmygate/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the WatchMyGate console",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "node launch.cjs --dev",
    "smoke": "node launch.cjs --smoke",
    "build": "npm run admin:build --prefix ../.. && electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12"
  }
}
