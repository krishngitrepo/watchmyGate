{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WatchMyGate",
  "version": "0.1.0",
  "identifier": "in.watchmygate.desktop",

  "build": {
    "beforeDevCommand": "npm run dev -w @watchmygate/web-admin",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build -w @watchmygate/web-admin",
    "frontendDist": "../../web-admin/out"
  },

  "app": {
    "windows": [
      {
        "title": "WatchMyGate",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.run.app https://api.razorpay.com"
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "copyright": "WatchMyGate",
    "category": "Business",
    "shortDescription": "Society management for committees and accountants",
    "longDescription": "Desktop console for society accounting, complaints and gate records."
  }
}
