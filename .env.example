# Copy to .env at the repository root and fill in the real values.
# NEVER commit a real .env. Production secrets live in Google Secret Manager.
#
# Every value below is a PLACEHOLDER. Replace them with real infrastructure
# credentials when available. Anything left blank runs in stub mode: the service is
# not called and the call is logged instead, so the app still starts.

ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database — Neon Postgres, Singapore (aws-ap-southeast-1)
# ---------------------------------------------------------------------------
# Connect as the RESTRICTED role, never the owner. The restricted role is created
# NOBYPASSRLS by migration 0001 and is what makes cross-society reads impossible.
# Pointing this at the owner role would silently void tenant isolation.
#
# Neon requires TLS (sslmode=require).
# Neon pools in transaction mode, so autosuspend must be DISABLED on the project or
# the first gate entry each morning waits for the database to wake.
#
# Use the -pooler host here: the API is many short transactions and wants the pooler.
DATABASE_URL=postgresql://watchmygate_app:PLACEHOLDER@ep-PLACEHOLDER-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Owner connection — migrations only. Needs DDL rights the app role must not have.
# Use the DIRECT host (no -pooler): CREATE ROLE and some DDL do not work through
# PgBouncer in transaction mode.
DATABASE_MIGRATION_URL=postgresql://neondb_owner:PLACEHOLDER@ep-PLACEHOLDER.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=PLACEHOLDER-generate-a-real-secret-before-deploying
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# MSG91 — SMS and login OTP
# Sender ID and templates must be DLT-registered with TRAI before they will deliver.
# ---------------------------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Razorpay — needs Route AND Smart Collect enabled on the account
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2 — photos and documents
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=watchmygate
R2_PUBLIC_HOST=

# ---------------------------------------------------------------------------
# Claude — OCR for bank statements, meter readings and staff IDs
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Exotel — IVR call at the 20-second rung of the approval ladder
# ---------------------------------------------------------------------------
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_CALLER_ID=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging — push notifications
# ---------------------------------------------------------------------------
FCM_CREDENTIALS_JSON=

# ---------------------------------------------------------------------------
# Google Cloud — Cloud Run, Tasks, Scheduler. Region must match Neon's.
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
CLOUD_TASKS_QUEUE=approval-ladder
WORKER_BASE_URL=
WORKER_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Service-to-service — the Python AI/device service authenticating to the TS API.
# It holds no database connection; everything goes through the core API.
# ---------------------------------------------------------------------------
SERVICE_TOKEN=
CORE_API_URL=http://localhost:8080

SENTRY_DSN=
